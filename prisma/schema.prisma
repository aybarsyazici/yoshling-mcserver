generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String     @id @default(cuid())
  discordId  String     @unique
  username   String
  avatar     String?
  role       String     @default("MEMBER") // ADMIN, MOD, MEMBER
  // Which worlds this user may see, as a CSV of game ids
  // ("minecraft,7dtd,zomboid"). Empty = no access yet, an admin has to grant it.
  // ADMIN ignores this column and always sees every world.
  games      String     @default("")
  createdAt  DateTime   @default(now())
  activities Activity[]
}

model InstalledMod {
  id          String   @id @default(cuid())
  modrinthId  String
  slug        String
  name        String
  version     String
  fileName    String
  mcVersion   String
  loader      String
  installedBy String
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// How this row got here: "pack" (a modpack apply) or "manual" (one mod, one request).
  /// Nullable because the three rows on production predate the column; they are backfilled
  /// to "manual", which is true of them — each was installed on its own, before any pack
  /// was ever applied. `reconcileMods` reads anything else as "not recorded".
  source String?

  /// The Modrinth version id the jar was downloaded from. Both writers have it in hand at
  /// the moment they create the row and neither used to keep it, so "which build is this"
  /// could only be answered by the version *number*, which is a publisher's free text.
  /// Nullable: pre-existing rows have none, and the Technic path has no Modrinth version.
  versionId String?
}

model ServerConfig {
  id           String @id @default("main")
  mcVersion    String @default("1.21.4")
  modLoader    String @default("fabric")
  rconPort     Int    @default(25575)
  rconPassword String @default("changeme")
  serverPort   Int    @default(25565)
  maxMemory    String @default("4G")
}

// Tracks which world currently holds the host's single "power slot".
// The box (8GB) can only run one game at a time; this records the intent
// so a host reboot only revives the world that was meant to be running.
model GameState {
  id         String   @id @default("main")
  activeGame String? // "minecraft" | "7dtd" | null (both idle)
  updatedAt  DateTime @updatedAt
}

// Curated 7 Days to Die server settings surfaced in the UI. The full set
// lives in sdtdserver.xml on disk; this row mirrors the friendly subset.
model SevenDaysConfig {
  id             String @id @default("main")
  serverName     String @default("Yoshling 7DTD")
  password       String @default("")
  maxPlayers     Int    @default(8)
  gameDifficulty Int    @default(2)
  dayLength      Int    @default(60)
  version        String @default("stable")
  maxMemory      String @default("5G")
  // Encoded Sandbox Options preset from the game's new-game screen; written to
  // the SandboxCode property in sdtdserver.xml.
  sandboxCode    String @default("")
}

// Title/mod-id cache for the Project Zomboid Workshop items listed in the
// server .ini. The .ini stays the source of truth for what is enabled; this
// row just remembers what a Workshop id *is* so the UI can show a name instead
// of a number, and which mod ids belong to it (needed to remove them again).
model ZomboidMod {
  id          String   @id // the Steam Workshop published file id
  title       String   @default("")
  // Semicolon-separated mod ids this workshop item provides.
  modIds      String   @default("")
  previewUrl  String?
  addedBy     String   @default("")
  addedAt     DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())
}

// `model ModRequest` was here, with a `User.modRequests` back-relation, and nothing in the
// app ever read or wrote either: zero rows in production, and zero references outside the
// generated client. `permissions.ts` already records its capability (`mods.request`) as one
// of five keys deleted for describing a feature that "exists in the Prisma schema and
// nowhere in the code" — this is the other half of that cleanup.
//
// **The empty table is deliberately left on the production database.** Dropping it would be
// a hand-applied destructive migration (prod runs none automatically) for no gain; an unused
// table costs nothing, while a `DROP TABLE` run by hand against the one DB is a risk with no
// upside. So dev and prod differ here by one table that neither reads.

model Modpack {
  id              String      @id @default(cuid())
  name            String
  description     String      @default("")
  createdBy       String
  targetMcVersion String?
  targetLoader    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  mods            ModpackMod[]
}

model ModpackMod {
  id          String  @id @default(cuid())
  modpackId   String
  modpack     Modpack @relation(fields: [modpackId], references: [id], onDelete: Cascade)
  modrinthId  String?
  slug        String
  name        String
  versionId   String?
  downloadUrl String?
}

