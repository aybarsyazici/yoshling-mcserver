// Synthetic, and deliberately so. The real production manifest
// (appworkshop_108600.acf, taken 2026-09-29) was fully up to date: for all 75 items
// `WorkshopItemsInstalled.timeupdated` equalled `WorkshopItemDetails.latest_timeupdated`,
// so it cannot tell a correct parser from the slice-to-end-of-file one that made
// installed == published for every mod. This file is the same shape with the two
// sections DISAGREEING for one item, which is the only state where the bug is visible.
//
// "2335368829" is stale: installed 1789340498, published 1799999999.
// "2366717227" is current: both 1787109082.
//
// The leading `//` lines are not Valve KeyValues syntax; the parser is brace-driven and
// starts at the first `"<SectionName>"` it is asked for, so they are inert.
"AppWorkshop"
{
	"appid"		"108600"
	"SizeOnDisk"		"3897274528"
	"NeedsUpdate"		"0"
	"NeedsDownload"		"0"
	"TimeLastUpdated"		"0"
	"TimeLastAppRan"		"0"
	"LastBuildID"		"0"
	"WorkshopItemsInstalled"
	{
