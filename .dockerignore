# Admit only the web build's inputs. Runtime secrets and game data stay on the
# host/in Docker volumes; they must never enter an image layer or build cache.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!prisma.config.ts
!prisma/
!prisma/**
!public/
!public/**
!src/
!src/**
!scripts/
scripts/**
!scripts/verify-build-artifact.mjs
!scripts/plan-discord-whitelist.mjs

# These exclusions also apply inside an admitted directory.
**/.env*
**/.git
**/.git/**
**/.claude
**/.claude/**
**/.codex
**/.codex/**
**/.worktrees
**/.worktrees/**
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite.*
**/*.sqlite3
**/*.sqlite3-*
**/*.sqlite3.*
**/*.pem
**/*.key
**/node_modules
**/node_modules/**
**/.next
**/.next/**
src/generated/prisma
src/generated/prisma/**
